// ======================================================================
// Office Script — Exportar AFAZ (Painel do ESER)
// Lê a aba "qAFAZAtual" e devolve o texto do dados_afaz.json
// Uso: Power Automate → "Executar script" → publicar o resultado no GitHub.
// ======================================================================
function main(workbook: ExcelScript.Workbook): string {
    const ABA = "qAFAZAtual";
    const aba = workbook.getWorksheet(ABA);
    if (!aba) throw new Error(`Aba "${ABA}" não encontrada.`);
    const valores = aba.getUsedRange().getValues() as (string | number | boolean)[][];

    const ABA_EVENTOS = "qEventosAFAZ";
    const abaEv = workbook.getWorksheet(ABA_EVENTOS);
    const valoresEv = abaEv ? (abaEv.getUsedRange().getValues() as (string | number | boolean)[][]) : null;

    return processar(valores, valoresEv);
}

// Statuses tratados/fechados (igual à medida do Power BI).
const TRATADOS = new Set(["Finalizado", "Resolvido", "Pendência Claro"]);

// Semana no estilo WEEKNUM(data, 1) do Power BI (semana começa no domingo,
// a semana 1 é a que contém 1º de janeiro) — calculado direto no código,
// sem depender de uma tabela Calendário.
function semanaChave(d: Date): { chaveOrdenacao: number; rotulo: string } {
    const ano = d.getFullYear();
    const inicioAno = new Date(ano, 0, 1);
    const diasDesdeInicio = Math.floor((d.getTime() - inicioAno.getTime()) / 86400000);
    const diaSemanaInicioAno = inicioAno.getDay(); // 0 = domingo
    const semana = Math.floor((diasDesdeInicio + diaSemanaInicioAno) / 7) + 1;
    return { chaveOrdenacao: ano * 100 + semana, rotulo: "W" + String(semana).padStart(2, "0") };
}

function processar(
    valores: (string | number | boolean)[][],
    valoresEv: (string | number | boolean)[][] | null
): string {
    const norm = (s: string) => String(s ?? "").normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase().trim();
    const cab = valores[0].map(c => norm(String(c)));
    const idx = (...nomes: string[]): number => {
        for (const n of nomes) { const i = cab.indexOf(norm(n)); if (i >= 0) return i; }
        return -1;
    };

    const C = {
        id: idx("id"),
        prioridade: idx("Prioridade"),
        site: idx("Site"),
        status: idx("Status"),
        tipoSite: idx("Tipo Site"),
        titulo: idx("Titulo"),
        abertura: idx("Abertura"),
        areaSistema: idx("Área/Sistema"),
        responsavel: idx("Responsável"),
        previsao: idx("Previsão"),
        tempoAbertura: idx("Tempo de Abertura(horas)"),
        tempoStatus: idx("Tempo do Status(horas)"),
        ultimaAtualizacao: idx("Ultima Atualização"),
        dataFotografia: idx("Data Fotografia"),
        origemCarteira: idx("Origem Carteira"),
        equipeEngemon: idx("Equipe Engemon"),
        sitePrioritario: idx("Site Prioritário"),
    };
    const faltando = Object.keys(C).filter(k => (C as Record<string, number>)[k] < 0);
    if (faltando.length) throw new Error("Colunas não encontradas: " + faltando.join(", "));

    const val = (l: (string | number | boolean)[], i: number) => (i < 0 ? "" : l[i]);
    const txt = (v: string | number | boolean) => String(v ?? "").replace(/\u00a0/g, " ").trim();
    const pad = (n: number) => String(n).padStart(2, "0");

    const data = (v: string | number | boolean): string | null => {
        if (typeof v === "number" && v > 20000) {
            const d = new Date(Math.round((v - 25569) * 86400000));
            return `${d.getUTCFullYear()}-${pad(d.getUTCMonth() + 1)}-${pad(d.getUTCDate())}`;
        }
        if (v instanceof Date) return `${v.getFullYear()}-${pad(v.getMonth() + 1)}-${pad(v.getDate())}`;
        const m = txt(v).match(/^(\d{1,2})\/(\d{1,2})\/(\d{4})/);
        return m ? `${m[3]}-${pad(+m[2])}-${pad(+m[1])}` : null;
    };
    const num = (v: string | number | boolean): number | null => {
        if (typeof v === "number") return Math.round(v * 100) / 100;
        const s = txt(v).replace(",", ".");
        if (s === "") return null;
        const n = Number(s);
        return isNaN(n) ? null : Math.round(n * 100) / 100;
    };

    const registros: object[] = [];
    for (let r = 1; r < valores.length; r++) {
        const l = valores[r];
        if (!txt(val(l, C.id))) continue;
        const oc = txt(val(l, C.origemCarteira)) || "Sem origem";
        const sp = txt(val(l, C.sitePrioritario)) || "Não";
        // Carteira Indicador (igual à lógica do Power BI): sites prioritários
        // saem de Backlog/Entrante e viram categoria própria "Prioritário".
        const ci = sp === "Sim" ? "Prioritário" : oc;
        registros.push({
            id: txt(val(l, C.id)),
            pr: txt(val(l, C.prioridade)),
            s: txt(val(l, C.site)),
            st: txt(val(l, C.status)) || "Sem status",
            ts: txt(val(l, C.tipoSite)),
            ti: txt(val(l, C.titulo)),
            ab: data(val(l, C.abertura)),
            ar: txt(val(l, C.areaSistema)),
            resp: txt(val(l, C.responsavel)),
            prev: data(val(l, C.previsao)),
            ta: num(val(l, C.tempoAbertura)),
            tst: num(val(l, C.tempoStatus)),
            ua: data(val(l, C.ultimaAtualizacao)),
            df: data(val(l, C.dataFotografia)),
            oc: oc,
            eq: txt(val(l, C.equipeEngemon)) || "Sem equipe",
            sp: sp,
            ci: ci,
        });
    }

    // --------------------------------------------------------------------
    // "Entrantes em Esteira Acumulados" por semana: entre os itens AINDA
    // pendentes HOJE (Origem Carteira=Entrante, não prioritário, não
    // tratado), agrupa pela semana de Abertura e acumula — mostra quantos
    // dos entrantes hoje pendentes já tinham sido abertos até cada semana.
    // Não depende de histórico diário, só da foto atual (qAFAZAtual).
    // --------------------------------------------------------------------
    const entrantesAcumulados: object[] = [];
    {
        type Candidato = { ab: string };
        const candidatos: Candidato[] = (registros as unknown as { oc: string; sp: string; st: string; ab: string | null }[])
            .filter(reg => reg.oc === "Entrante" && reg.sp !== "Sim" && !TRATADOS.has(reg.st) && !!reg.ab)
            .map(reg => ({ ab: reg.ab as string }));

        if (candidatos.length) {
            const semanaDeIso = (iso: string) => {
                const [y, m, d] = iso.split("-").map(n => Number(n));
                return semanaChave(new Date(y, m - 1, d));
            };
            const semanasCandidatos = candidatos.map(c => semanaDeIso(c.ab).chaveOrdenacao);
            const minData = candidatos.reduce((min, c) => (c.ab < min ? c.ab : min), candidatos[0].ab);
            const [ay, am, ad] = minData.split("-").map(n => Number(n));
            const minDate = new Date(ay, am - 1, ad);
            const hoje = new Date(Date.now() - 3 * 3600000);
            const anoSemanaHoje = semanaChave(hoje).chaveOrdenacao;

            const cursor = new Date(minDate);
            cursor.setDate(cursor.getDate() - cursor.getDay()); // volta pro domingo da semana
            let guarda = 0;
            while (guarda < 60) { // teto de segurança: ~ 1 ano de semanas
                guarda++;
                const sem = semanaChave(cursor);
                if (sem.chaveOrdenacao > anoSemanaHoje) break;
                const count = semanasCandidatos.filter(c => c <= sem.chaveOrdenacao).length;
                entrantesAcumulados.push({ semana: sem.rotulo, entrantesAcumulados: count });
                cursor.setDate(cursor.getDate() + 7);
            }
        }
    }

    // --------------------------------------------------------------------
    // "Prioritários em Esteira" por semana: qEventosAFAZ tem uma linha por
    // item a cada dia de captura (histórico diário). Para cada semana,
    // pega a ÚLTIMA data de captura dentro dela e conta, nessa foto,
    // quantos itens são Site Prioritário = Sim e ainda não tratados.
    // --------------------------------------------------------------------
    const semanal: object[] = [];
    if (valoresEv && valoresEv.length > 1) {
        const cabEv = valoresEv[0].map(c => norm(String(c)));
        const idxEv = (...nomes: string[]): number => {
            for (const n of nomes) { const i = cabEv.indexOf(norm(n)); if (i >= 0) return i; }
            return -1;
        };
        const E = {
            id: idxEv("id"),
            status: idxEv("Status"),
            sitePrioritario: idxEv("Site Prioritário"),
            dataFotografia: idxEv("Data Fotografia"),
        };
        if (E.id >= 0 && E.status >= 0 && E.sitePrioritario >= 0 && E.dataFotografia >= 0) {
            // 1ª passada: data (string ISO) de cada linha + última data de cada semana
            const dataPorLinha: (string | null)[] = [];
            const ultimaDataPorSemana: Record<number, string> = {};
            const rotuloPorSemana: Record<number, string> = {};
            for (let r = 1; r < valoresEv.length; r++) {
                const l = valoresEv[r];
                const dRaw = val(l, E.dataFotografia);
                const dObj = dRaw instanceof Date ? dRaw : null;
                if (!dObj) { dataPorLinha.push(null); continue; }
                const dIso = `${dObj.getFullYear()}-${pad(dObj.getMonth() + 1)}-${pad(dObj.getDate())}`;
                dataPorLinha.push(dIso);
                const sem = semanaChave(dObj);
                if (!ultimaDataPorSemana[sem.chaveOrdenacao] || dIso > ultimaDataPorSemana[sem.chaveOrdenacao]) {
                    ultimaDataPorSemana[sem.chaveOrdenacao] = dIso;
                }
                rotuloPorSemana[sem.chaveOrdenacao] = sem.rotulo;
            }
            // 2ª passada: conta, na última data de cada semana, os itens
            // Site Prioritário = Sim e ainda não tratados (ids distintos).
            const idsPorSemana: Record<number, Set<string>> = {};
            for (let r = 1; r < valoresEv.length; r++) {
                const l = valoresEv[r];
                const dIso = dataPorLinha[r - 1];
                if (!dIso) continue;
                const dObj = val(l, E.dataFotografia) as Date;
                const sem = semanaChave(dObj);
                if (dIso !== ultimaDataPorSemana[sem.chaveOrdenacao]) continue;
                const sp = txt(val(l, E.sitePrioritario));
                const st = txt(val(l, E.status));
                if (sp !== "Sim" || TRATADOS.has(st)) continue;
                if (!idsPorSemana[sem.chaveOrdenacao]) idsPorSemana[sem.chaveOrdenacao] = new Set();
                idsPorSemana[sem.chaveOrdenacao].add(txt(val(l, E.id)));
            }
            Object.keys(idsPorSemana).map(n => Number(n)).sort((a, b) => a - b).forEach(chave => {
                semanal.push({ semana: rotuloPorSemana[chave], prioritariosEmEsteira: idsPorSemana[chave].size });
            });
        }
    }

    const agora = new Date(Date.now() - 3 * 3600000);
    const geradoEm = `${agora.getUTCFullYear()}-${pad(agora.getUTCMonth() + 1)}-${pad(agora.getUTCDate())} ${pad(agora.getUTCHours())}:${pad(agora.getUTCMinutes())}`;

    return JSON.stringify({
        gerado_em: geradoEm,
        registros,
        semanal,
        entrantesAcumulados,
    });
}
